# AP Coder settings. Every invoice is read the same way, with nothing to choose: the PDF's own text or OCR on this
# computer, OvisOCR2 in LM Studio reading every page as a second reader (found and self-tested by itself), the
# supplier's template and the business checks. Settings → Reading in the dashboard shows how each reader is doing.

# --- LM Studio on this computer (set by IT only if it isn't at its usual address) ---------------------------------
# Any address LM Studio shows (Developer tab).
# AP_LLM_BASE_URL=http://127.0.0.1:1234/v1
# Empty = the chat model loaded in LM Studio (it suggests GL accounts; optional). Name one to pin it.
# AP_LLM_MODEL=
# LM Studio accepts any key.
# AP_LLM_API_KEY=lm-studio
# Invoice text sent to the chat model (a longer one keeps its start and end), for a small context window.
# AP_LLM_MAX_PROMPT_CHARS=24000
# AP_LLM_TIMEOUT_SECONDS=600
# AP_LLM_MAX_TOKENS=4096

# --- Engine behaviour -------------------------------------------------------
# For command-line use without the dashboard: folder holding chart_of_accounts.csv, cost_centers.csv,
# tax_gl_mapping.csv and coding_policy.md
# (default: the dashboard database, else ./private/reference, else the bundled sample data in ./data)
# AP_REFERENCE_DIR=private/reference
# Embed valid GL / cost-center codes as enums in the strict schema.
AP_CONSTRAIN_CODES=true
# Name recorded on approvals in the dashboard (defaults to your login name).
# AP_REVIEWER=Jane Doe
# Adjusted confidence below this (or any validation error) => requires_review.
AP_REVIEW_THRESHOLD=0.85
AP_MAX_DOCUMENT_CHARS=200000

# --- Developer only: cloud services --------------------------------------------------------------------------------
# IGNORED by the offline build. Used only when AP_ALLOW_INTERNET=1 is set on a developer's computer; never needed
# to read or code invoices.
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_MODEL_NAME=
