# --- Azure AI Document Intelligence (Component 1) ---------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# Leave the key empty to authenticate with Entra ID (DefaultAzureCredential / az login).
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# prebuilt-layout (pure layout/table Markdown) or prebuilt-invoice (adds field hints used for cross-checks)
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout
# AZURE_DOCUMENT_INTELLIGENCE_LOCALE=en-GB
# AZURE_DOCUMENT_INTELLIGENCE_PAGES=1-10

# --- Azure OpenAI (Component 2) -----------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Structured Outputs requires 2024-08-01-preview or later.
AZURE_OPENAI_API_VERSION=2024-10-21
# Your deployment name, plus the underlying model so capabilities are detected correctly.
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_MODEL_NAME=gpt-4o
# "none" to omit (reasoning models never receive temperature/seed).
AZURE_OPENAI_TEMPERATURE=0
AZURE_OPENAI_SEED=42
AZURE_OPENAI_MAX_OUTPUT_TOKENS=8000
# Only sent to reasoning models (o-series, gpt-5): low | medium | high
# AZURE_OPENAI_REASONING_EFFORT=medium
# Force vision capability on/off instead of detecting it from the model name.
# AZURE_OPENAI_SUPPORTS_VISION=true
AZURE_OPENAI_TIMEOUT_SECONDS=120
AZURE_OPENAI_MAX_RETRIES=5

# --- Engine behaviour -------------------------------------------------------
# Folder holding chart_of_accounts.csv, cost_centers.csv, tax_codes.csv, coding_policy.md
# (default: ./private/reference if present, else the bundled sample data in ./data)
# AP_REFERENCE_DIR=private/reference
# Attach rendered page images alongside the extracted Markdown (vision-capable models only).
AP_VISION=false
AP_VISION_MAX_PAGES=5
# Embed valid GL / cost-center codes as enums in the strict schema.
AP_CONSTRAIN_CODES=true
# Name recorded on approvals in the dashboard (defaults to your login name).
# AP_REVIEWER=Jane Doe
# Adjusted confidence below this (or any validation error) => requires_review.
AP_REVIEW_THRESHOLD=0.85
AP_MAX_DOCUMENT_CHARS=200000
