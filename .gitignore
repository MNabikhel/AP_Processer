__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.env
.env.*
!.env.example
.cache/
output/

# Enterprise data: invoices, reference exports, outputs, labels. Never commit.
private/*
!private/README.md
# Belt and braces: spreadsheets and documents outside samples/ are never committed either.
*.xlsx
*.xls
*.xlsm
/*.csv
/*.pdf
/*.tif
/*.tiff
/*.png
/*.jpg
/*.jpeg
/*.zip
# Databases and saved emails, in any folder.
*.db
*.db-wal
*.db-shm
*.sqlite*
*.eml
*.msg
# The data folder's own folders, when they are made next to the code.
/invoices/
/exports/
/backups/
/pilot_score/
/training/
# The made-up samples under data/, samples/, tests/fixtures/ and docs/ are tracked on purpose: each one is named in
# tests/meta/data_files.txt, and a new data file anywhere fails tests/meta/test_data_files.py until it is added there.

# Claude Code agent worktrees
.claude/worktrees/

# Capture benchmark output (python -m ap_coder.bench run)
bench_out/
bench_coding/
bench_learn/

# Offline bundle (python scripts/build_offline_bundle.py): downloaded packages and OCR models
/wheelhouse/
/models/

# The launcher's lock file (scripts/launch.py: one start at a time)
/.ap_coder_launch.lock
